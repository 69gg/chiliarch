{
  "additionalProperties": false,
  "description": "One durable message identity, preserved across retries and transports.",
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Type",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "type"
  ],
  "title": "Envelope",
  "type": "object",
  "$defs": {
    "HeartbeatMetadata": {
      "additionalProperties": true,
      "description": "Known telemetry keys remain optional; adapters may add their own metadata.",
      "properties": {
        "introduction": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Agent-authored plain text, never an instruction or permission grant; null clears it.",
          "title": "Introduction"
        }
      },
      "title": "HeartbeatMetadata",
      "type": "object"
    },
    "HeartbeatPayload": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "ready",
          "title": "Status",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/HeartbeatMetadata"
        }
      },
      "title": "HeartbeatPayload",
      "type": "object"
    },
    "AckPayload": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id"
      ],
      "title": "AckPayload",
      "type": "object"
    },
    "DispatchPayload": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "workdir": {
          "anyOf": [
            {
              "description": "Absolute directory on the agent machine; omitted uses its local default.",
              "maxLength": 4096,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f]"
              },
              "pattern": "^(?:/|[a-zA-Z]:[\\\\/]|\\\\\\\\)[^\\x00-\\x1f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workdir"
        }
      },
      "required": [
        "task_id",
        "instruction"
      ],
      "title": "DispatchPayload",
      "type": "object"
    },
    "CancelPayload": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "reason": {
          "default": "User requested cancellation",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "CancelPayload",
      "type": "object"
    },
    "TaskStatusPayload": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Progress"
        },
        "result": {
          "default": null,
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "task_id",
        "status"
      ],
      "title": "TaskStatusPayload",
      "type": "object"
    },
    "AgentRequestPayload": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
