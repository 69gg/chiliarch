        "status": {
          "enum": [
            "approved",
            "rejected",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "result": {
          "default": null,
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
