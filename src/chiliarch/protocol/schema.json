          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "message"
      ],
      "title": "AgentContactPayload",
      "type": "object"
    },
    "AgentMessagePayload": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "message"
      ],
      "title": "AgentMessagePayload",
      "type": "object"
    },
    "RequestResolvedPayload": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
